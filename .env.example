# ===========================================
# Supabase – חיבור לפרויקט ב-Supabase
# ===========================================
# 1. העתק את הקובץ הזה ושנה את השם ל-.env
# 2. מלא את הערכים למטה (בלי רווחים מסביב ל-=)
# 3. את שני הערכים תמצא ב-Supabase Dashboard:
#    https://supabase.com/dashboard → בחר/צור פרויקט → Settings (תפריט שמאל) → API
# ===========================================

# כתובת ה-API של הפרויקט (Project URL)
# ב-Dashboard: Settings → API → Project URL
VITE_SUPABASE_URL=https://hdsmcqfcexegipjdrpmz.supabase.co

# מפתח ציבורי (anon/public) – מאפשר גישה מהדפדפן
# ב-Dashboard: Settings → API → Project API keys → ערך של "anon" / "public"
# חשוב: אל תשתמש ב-service_role בדף – רק anon key
VITE_SUPABASE_ANON_KEY=sb_publishable_wMEEFo1ebzJhTnxkXRH7VA_SW1SjYqV

# Stripe – מפתח ציבורי (Publishable key) לתשלומים / stakes
# ב-Stripe Dashboard: Developers → API keys → Publishable key (מתחיל ב-pk_test_ או pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51T3wf0DdpfbhbDG6jIZ4s0kegsY3Ono4INQjm0Ldm4tTc2ztLxRpnfnUtKZfkrOeJV0CEmTj5KDvR9PMVaIlFBl4004G2NE6mL
